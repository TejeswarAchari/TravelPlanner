# Copy to .env and fill in real values. Never commit a real .env.
# Generate a secret with: python -c 'import secrets; print(secrets.token_hex(32))'

# Flask session secret. Required in production (FLASK_ENV=production refuses
# to start without it); in local dev a random ephemeral key is used instead.
SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# Leave unset/0 for plain-HTTP localhost development.
SESSION_COOKIE_SECURE=0

# Optional overrides:
# DATABASE_PATH=backend/travelplanner.db
# FLASK_DEBUG=1
# FLASK_ENV=production
